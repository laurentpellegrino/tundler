[Unit]
Description=Forward tundler-tunnel journal to the container log (kubectl logs)
After=systemd-journald.service
# tundler-tunnel.service may not exist yet when this unit fires; that's
# fine — journalctl -f blocks until matching entries appear.
# Requires the FIFO created by tundler-entrypoint.sh before systemd
# boots; opening it blocks until the entrypoint's drain loop reads.

[Service]
Type=simple
# Tail tundler-tunnel.service entries in plain "message-only" format
# so the container log shows the same Go log line we'd see in
# journalctl -u tundler-tunnel, plus systemd's own lines about the
# unit (exit status, signal, restart). The destination is the FIFO
# that tundler-entrypoint.sh drains into the container's real stdout:
# writing to /proc/1/fd/1 reaches nothing, PID 1 (systemd) reopens its
# stdio on /dev/null at boot. --lines=all replays entries logged before
# this unit started (the first boot of the binary is the one that
# matters after a crash-recreate).
ExecStart=/bin/sh -c 'exec journalctl --follow --lines=all --unit=tundler-tunnel.service --no-pager --output=cat >/run/tundler/stdout 2>&1'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
